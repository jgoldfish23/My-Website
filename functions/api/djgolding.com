<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Jameson &amp; Dawsyn</title>
<meta name="description" content="A running record of two lives, currently merging.">
<meta name="theme-color" content="#0C2523">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500&display=swap" rel="stylesheet">
<style>
  /* ============ tokens ============ */
  :root{
    --display:"Inter", system-ui, sans-serif;
    --body:"Inter", system-ui, sans-serif;
    --util:"Inter", system-ui, sans-serif;

    --gutter:clamp(20px, 5vw, 76px);
    --stack:clamp(80px, 13vh, 152px);
    --bar:60px;
    --ease:cubic-bezier(.22,.68,.32,1);
  }

  html[data-theme="dark"]{
    --bg:#0C2523;  --bg-2:#071A19;  --bg-3:rgba(255,255,255,.022);
    --fg:#E9EEE9;  --fg-2:#8AA697;  --fg-3:#C2D0C6;
    --accent:#D2A94E; --accent-soft:rgba(210,169,78,.16);
    --line:rgba(138,166,151,.24); --line-2:rgba(138,166,151,.13);
    --shell:rgba(12,37,35,.72);
  }
  html[data-theme="light"]{
    --bg:#F3F5F2;  --bg-2:#E8ECE7;  --bg-3:rgba(14,36,34,.025);
    --fg:#0E2422;  --fg-2:#5C7369;  --fg-3:#3A4F49;
    --accent:#8A6717; --accent-soft:rgba(138,103,23,.12);
    --line:rgba(14,36,34,.17); --line-2:rgba(14,36,34,.09);
    --shell:rgba(243,245,242,.78);
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth; scroll-padding-top:calc(var(--bar) + 24px);}
  body{
    margin:0; background:var(--bg); color:var(--fg);
    font-family:var(--body); font-weight:300; font-size:16.5px; line-height:1.68;
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
    transition:background .45s var(--ease), color .45s var(--ease);
  }
  ::selection{background:var(--accent); color:var(--bg);}
  a{color:inherit;}
  img{display:block; max-width:100%;}
  :focus-visible{outline:2px solid var(--accent); outline-offset:3px; border-radius:2px;}

  .wrap{max-width:1120px; margin:0 auto; padding:0 var(--gutter);}
  section{padding:var(--stack) 0;}

  /* ============ shell ============ */
  .shell{
    position:fixed; inset:0 0 auto 0; height:var(--bar); z-index:60;
    background:var(--shell); backdrop-filter:blur(14px); -webkit-backdrop-filter:blur(14px);
    border-bottom:1px solid var(--line-2);
    transition:background .45s var(--ease), border-color .45s var(--ease);
  }
  .shell-in{
    max-width:1120px; margin:0 auto; padding:0 var(--gutter); height:100%;
    display:flex; align-items:center; gap:12px;
  }
  .monogram{
    font-family:var(--display); font-weight:500; font-size:15px;
    letter-spacing:.14em; text-decoration:none;
  }
  .nav{display:flex; gap:26px; margin-left:auto;}
  .nav a{
    font-family:var(--util); font-size:11px; letter-spacing:.14em; text-transform:uppercase;
    color:var(--fg-2); text-decoration:none; transition:color .2s var(--ease);
  }
  .nav a:hover{color:var(--accent);}

  .toggle{
    margin-left:26px; width:38px; height:38px; flex:0 0 38px; border-radius:50%;
    display:grid; place-items:center; cursor:pointer;
    background:transparent; border:1px solid var(--line); color:var(--fg-2);
    transition:border-color .25s var(--ease), color .25s var(--ease), background .25s var(--ease);
  }
  .toggle:hover{border-color:var(--accent); color:var(--accent); background:var(--accent-soft);}
  .toggle svg{width:16px; height:16px; fill:none; stroke:currentColor; stroke-width:1.6;
    stroke-linecap:round; stroke-linejoin:round;}
  html[data-theme="dark"] .i-sun{display:block;}
  html[data-theme="dark"] .i-moon{display:none;}
  html[data-theme="light"] .i-sun{display:none;}
  html[data-theme="light"] .i-moon{display:block;}

  /* ============ shared type ============ */
  .eyebrow{
    font-family:var(--util); font-size:10.5px; font-weight:500;
    letter-spacing:.19em; text-transform:uppercase; color:var(--fg-2);
  }
  .sec-head{
    display:flex; align-items:baseline; gap:20px;
    padding-bottom:16px; margin-bottom:48px; border-bottom:1px solid var(--line);
  }
  .sec-head h2{
    font-family:var(--display); font-weight:400; font-size:clamp(24px,3.6vw,34px);
    margin:0; letter-spacing:-.03em;
  }
  .sec-head .eyebrow{margin-left:auto; white-space:nowrap;}

  /* ============ hero ============ */
  .hero{
    min-height:100svh; display:flex; flex-direction:column;
    padding-top:calc(var(--bar) + 40px); padding-bottom:56px;
    position:relative; overflow:hidden;
  }
  .hero-in{position:relative; display:flex; flex-direction:column; flex:1;}
  .hero-coords{display:flex; gap:26px; flex-wrap:wrap; margin-bottom:auto;}

  .names{
    font-family:var(--display); font-weight:300;
    font-size:clamp(46px, 12.8vw, 140px); line-height:.94; font-weight:200;
    letter-spacing:-.042em; margin:0;
  }
  .names .amp{
    display:block; font-family:var(--util); font-weight:400;
    font-size:clamp(11px,1.2vw,13px); letter-spacing:.34em; text-transform:uppercase;
    color:var(--accent); margin:.9em 0 .85em .3em;
  }
  .names .two{display:block; padding-left:clamp(18px,8vw,148px);}
  .hero-sub{
    max-width:36ch; margin:40px 0 0; color:var(--fg-2);
    font-size:clamp(15.5px,1.9vw,18px);
  }

  .count{margin-top:auto; padding-top:48px; display:flex; align-items:flex-end;
    gap:clamp(16px,3.4vw,36px); flex-wrap:wrap;}
  .count-n{
    font-family:var(--display); font-weight:300; font-size:clamp(54px,9.5vw,104px);
    line-height:.82; letter-spacing:-.04em; color:var(--accent);
    font-variant-numeric:tabular-nums;
  }
  .count-label{font-family:var(--util); font-size:10.5px; letter-spacing:.18em;
    text-transform:uppercase; color:var(--fg-2); padding-bottom:9px; line-height:1.9;}

  .hero-line{position:absolute; inset:0; width:100%; height:100%; pointer-events:none; opacity:.42;}
  .hero-line path{
    fill:none; stroke:var(--accent); stroke-width:1;
    stroke-dasharray:1500; stroke-dashoffset:1500;
    animation:draw 2.8s var(--ease) .3s forwards;
  }
  @keyframes draw{to{stroke-dashoffset:0;}}

  /* ============ the two ============ */
  .pair{display:grid; grid-template-columns:1fr 1fr; gap:clamp(20px,3.4vw,40px);}
  .card{
    border:1px solid var(--line); border-radius:3px; background:var(--bg-3);
    padding:clamp(24px,3.2vw,38px);
    transition:border-color .3s var(--ease), transform .3s var(--ease);
  }
  .card:hover{border-color:var(--accent); transform:translateY(-3px);}
  .card h3{
    font-family:var(--display); font-weight:400; font-size:clamp(21px,2.8vw,27px);
    margin:0 0 6px; letter-spacing:-.03em;
  }
  .card .role{font-family:var(--util); font-size:10.5px; letter-spacing:.16em;
    text-transform:uppercase; color:var(--accent); margin-bottom:22px;}
  .card p{margin:0 0 24px; color:var(--fg-3); font-size:15.5px;}
  .facts{list-style:none; margin:0; padding:0; border-top:1px solid var(--line-2);}
  .facts li{display:flex; gap:16px; padding:10px 0; border-bottom:1px solid var(--line-2); font-size:14px;}
  .facts b{
    font-family:var(--util); font-weight:400; font-size:10px; letter-spacing:.14em;
    text-transform:uppercase; color:var(--fg-2); min-width:80px; padding-top:4px; flex:0 0 80px;
  }

  /* ============ record ============ */
  .record{position:relative; padding-left:clamp(30px,7vw,88px);}
  .spine{
    position:absolute; left:clamp(6px,2.4vw,30px); top:8px; bottom:8px; width:1px;
    background:linear-gradient(180deg, transparent, var(--line) 10%, var(--accent));
  }
  .entry{position:relative; padding-bottom:52px;}
  .entry:last-child{padding-bottom:0;}
  .entry::before{
    content:""; position:absolute; left:calc(-1 * clamp(24px,4.6vw,58px) - 3px);
    top:11px; width:7px; height:7px; border-radius:50%;
    background:var(--bg); border:1px solid var(--fg-2);
  }
  .entry.mark::before{background:var(--accent); border-color:var(--accent);
    box-shadow:0 0 0 5px var(--accent-soft);}
  .entry time{font-family:var(--util); font-size:10.5px; letter-spacing:.16em;
    text-transform:uppercase; color:var(--accent); display:block; margin-bottom:7px;}
  .entry h4{font-family:var(--display); font-weight:400; font-size:clamp(18px,2.3vw,23px);
    margin:0 0 8px; letter-spacing:-.025em;}
  .entry p{margin:0; color:var(--fg-2); max-width:58ch; font-size:15px;}

  /* ============ plate ============ */
  .plate{margin:0; display:grid; grid-template-columns:minmax(0,1fr) minmax(0,.82fr);
    gap:clamp(26px,5vw,68px); align-items:center;}
  .plate-img{border:1px solid var(--line); border-radius:3px; padding:9px; background:var(--bg-3);}
  .plate-img img{width:100%; height:auto; border-radius:1px;}
  .plate-h{
    font-family:var(--display); font-weight:300; font-size:clamp(26px,4.2vw,42px);
    line-height:1.1; letter-spacing:-.035em; margin:18px 0 20px;
  }
  .plate-h em{font-style:normal; color:var(--accent);}
  .plate-sub{font-family:var(--util); font-size:11.5px; letter-spacing:.12em;
    color:var(--fg-2); line-height:2.1; margin:0;}

  /* ============ the day ============ */
  .day{background:var(--bg-2); transition:background .45s var(--ease);}
  .day-grid{display:grid; grid-template-columns:1.1fr 1fr; gap:clamp(28px,6vw,76px); align-items:center;}
  .day-h{
    font-family:var(--display); font-weight:300; font-size:clamp(30px,5.6vw,58px);
    line-height:1.1; letter-spacing:-.035em; margin:0 0 24px;
  }
  .day-h em{font-style:normal; color:var(--accent);}
  .details{list-style:none; margin:0; padding:0;}
  .details li{padding:17px 0; border-bottom:1px solid var(--line-2);}
  .details span{display:block; font-family:var(--util); font-size:10px; letter-spacing:.16em;
    text-transform:uppercase; color:var(--fg-2); margin-bottom:6px;}
  .details strong{font-weight:400; font-size:16px; font-family:var(--display); letter-spacing:-.02em;}
  .lnk{color:var(--accent); text-decoration:none; border-bottom:1px solid var(--accent-soft);
    padding-bottom:2px; transition:border-color .2s var(--ease);}
  .lnk:hover{border-bottom-color:var(--accent);}

  /* ============ field notes ============ */
  .frames{display:grid; grid-template-columns:repeat(auto-fill,minmax(200px,1fr)); gap:12px;}
  .frame{
    aspect-ratio:4/5; border:1px dashed var(--line); border-radius:3px;
    display:flex; align-items:center; justify-content:center; text-align:center; padding:16px;
    color:var(--fg-2); font-family:var(--util); font-size:10px; letter-spacing:.16em;
    text-transform:uppercase; background:var(--bg-3);
  }
  .frame.filled{border-style:solid; padding:0; overflow:hidden;}
  .frame.filled img{width:100%; height:100%; object-fit:cover;
    transition:transform .7s var(--ease);}
  .frame.filled:hover img{transform:scale(1.035);}
  .frame.wide{grid-column:span 2; aspect-ratio:3/2;}
  .frames-note{margin:24px 0 0; color:var(--fg-2); font-size:14px; max-width:60ch;}

  /* ============ footer ============ */
  footer{background:var(--bg-2); padding:56px 0 68px; border-top:1px solid var(--line-2);
    transition:background .45s var(--ease);}
  .foot{display:flex; justify-content:space-between; gap:20px; flex-wrap:wrap; align-items:center;}
  .foot .mark{font-family:var(--display); font-weight:400; font-size:20px; letter-spacing:.1em;}

  /* ============ reveal ============ */
  .rise{opacity:0; transform:translateY(20px);
    transition:opacity .75s var(--ease), transform .75s var(--ease);}
  .rise.in{opacity:1; transform:none;}

  @media (max-width:820px){
    .pair,.day-grid,.plate{grid-template-columns:1fr;}
    .frame.wide{grid-column:span 1; aspect-ratio:4/5;}
    .nav{display:none;}
    .toggle{margin-left:auto;}
    .names .two{padding-left:0;}
    .hero{min-height:auto; padding-top:calc(var(--bar) + 52px);}
    .count{padding-top:64px;}
    .sec-head{flex-wrap:wrap; gap:6px;}
    .sec-head .eyebrow{margin-left:0; width:100%;}
  }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto;}
    .hero-line path{animation:none; stroke-dashoffset:0;}
    .rise{opacity:1; transform:none; transition:none;}
    .card:hover{transform:none;}
    .frame.filled:hover img{transform:none;}
  }
</style>
</head>
<body>

<div class="shell">
  <div class="shell-in">
    <a class="monogram" href="#top">J &amp; D</a>
    <nav class="nav">
      <a href="#two">Us</a>
      <a href="#record">Record</a>
      <a href="#day">The day</a>
    </nav>
    <button class="toggle" id="themeBtn" type="button" aria-label="Switch to light mode">
      <svg class="i-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.4v2.2M12 19.4v2.2M4.2 12H2M22 12h-2.2M5.6 5.6 7.2 7.2M16.8 16.8l1.6 1.6M18.4 5.6 16.8 7.2M7.2 16.8l-1.6 1.6"/></svg>
      <svg class="i-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.6A8.6 8.6 0 1 1 9.4 3.5a6.9 6.9 0 0 0 11.1 11.1Z"/></svg>
    </button>
  </div>
</div>

<!-- ============ HERO ============ -->
<header class="hero" id="top">
  <svg class="hero-line" viewBox="0 0 1200 800" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-40,250 C 300,250 420,470 700,520 C 900,556 1100,566 1240,568"/>
    <path d="M-40,760 C 320,760 430,600 700,540 C 900,496 1100,478 1240,472"/>
  </svg>

  <div class="wrap hero-in">
    <div class="hero-coords">
      <span class="eyebrow">41°04&#8242;N 111°58&#8242;W &nbsp;·&nbsp; Layton, Utah</span>
      <span class="eyebrow">35°38&#8242;N 120°41&#8242;W &nbsp;·&nbsp; Paso Robles, California</span>
    </div>

    <h1 class="names">
      Jameson
      <span class="amp">and</span>
      <span class="two">Dawsyn</span>
    </h1>

    <p class="hero-sub">A running record of two lives — where they've been, what they're building, and the day the two lines meet.</p>

    <div class="count">
      <div class="count-n" id="days">—</div>
      <div class="count-label">days until<br>December 30, 2026</div>
    </div>
  </div>
</header>

<!-- ============ THE TWO ============ -->
<section class="wrap" id="two">
  <div class="sec-head rise">
    <h2>The two of us</h2>
    <span class="eyebrow">01 — Who</span>
  </div>

  <div class="pair">
    <article class="card rise">
      <h3>Jameson Golding</h3>
      <div class="role">Cost Estimator · City Creek Construction</div>
      <p>Spends his days pricing buildings that don't exist yet — turning a set of drawings into a number somebody can sign. Off the clock he's usually building something else: an app, a spreadsheet nobody asked for, or a case for why BYU is finally going to figure it out this year.</p>
      <ul class="facts">
        <li><b>Based</b><span>Layton, Utah</span></li>
        <li><b>Works on</b><span>Commercial estimating, bid management, job costing</span></li>
        <li><b>Studied</b><span>MBA, Western Governors University — 2026</span></li>
        <li><b>Loyal to</b><span>Dawsyn · BYU · Utah Jazz · Eagles · Dodgers</span></li>
        <li><b>Off hours</b><span>Building web apps, gaming, the markets</span></li>
      </ul>
    </article>

    <article class="card rise">
      <h3>Dawsyn Jenkins</h3>
      <div class="role">Registered Nurse</div>
      <p>Spends her days taking care of people on the worst day they've had in a while — a job that doesn't leave much room for pretending. Off the clock she's pointed at the ocean, or at least at a long drive with the music up and nowhere in particular to be.</p>
      <ul class="facts">
        <li><b>Based</b><span>Paso Robles, California</span></li>
        <li><b>Works on</b><span>Nursing — keeping people alive and honest</span></li>
        <li><b>Studied</b><span>BSN, Nightingale College · RN</span></li>
        <li><b>Loyal to</b><span>Jameson · Fart</span></li>
        <li><b>Off hours</b><span>The ocean, drives with the jams on, getting that bread</span></li>
      </ul>
    </article>
  </div>
</section>

<!-- ============ THE RECORD ============ -->
<section class="wrap" id="record">
  <div class="sec-head rise">
    <h2>The record</h2>
    <span class="eyebrow">02 — When</span>
  </div>

  <div class="record">
    <div class="spine" aria-hidden="true"></div>

    <div class="entry rise">
      <time>The beginning</time>
      <h4>Mutual</h4>
      <p>Two states apart, matched on a dating app. Statistically unpromising. Went well anyway.</p>
    </div>

    <div class="entry rise">
      <time>June 2026</time>
      <h4>The Central Coast</h4>
      <p>A trip out to see Dawsyn in San Luis Obispo.</p>
    </div>

    <div class="entry rise">
      <time>June 10, 2026</time>
      <h4>Fernwood Lookout</h4>
      <p>Above Layton, with the valley and the lake laid out behind them. He asked. She said yes.</p>
    </div>

    <div class="entry rise">
      <time>July 2026</time>
      <h4>San Francisco</h4>
      <p>Giants at Oracle Park, the Phoenix pool, Coit Tower, and a lot of walking.</p>
    </div>

    <div class="entry mark rise">
      <time>December 30, 2026</time>
      <h4>The Wedding Bowl, La Jolla</h4>
      <p>Two o'clock in the afternoon, on a bluff above the Pacific. Dinner to follow at six.</p>
    </div>
  </div>
</section>

<!-- ============ PLATE ============ -->
<section class="wrap" id="plate">
  <figure class="plate rise">
    <div class="plate-img"><img src="data:image/jpeg;base64," alt="Jameson proposing to Dawsyn at Fernwood Lookout above the Layton valley"></div>
    <figcaption>
      <span class="eyebrow">Plate 01 — the ask</span>
      <p class="plate-h">She said <em>yes</em> on a bluff above the valley.</p>
      <p class="plate-sub">Fernwood Lookout · Layton, Utah<br>June 10, 2026</p>
    </figcaption>
  </figure>
</section>

<!-- ============ THE DAY ============ -->
<section class="day" id="day">
  <div class="wrap">
    <div class="sec-head rise">
      <h2>The day</h2>
      <span class="eyebrow">03 — Where</span>
    </div>

    <div class="day-grid">
      <div class="rise">
        <p class="day-h">Wednesday, the thirtieth of December, <em>two thousand twenty-six</em></p>
        <p style="color:var(--fg-2); max-width:40ch; margin:0;">On the bluff at Cuvier Park, above the water. Details for guests will land here as they're locked in.</p>
      </div>

      <ul class="details rise">
        <li><span>Ceremony</span><strong>2:00 in the afternoon</strong></li>
        <li><span>Venue</span><strong>The Wedding Bowl at Cuvier Park</strong></li>
        <li><span>City</span><strong>La Jolla, California</strong></li>
        <li><span>Reception</span><strong>6:00 in the evening</strong></li>
        <li><span>Everything else</span><strong><a class="lnk" href="#">Full details for guests — coming soon</a></strong></li>
      </ul>
    </div>
  </div>
</section>

<!-- ============ FIELD NOTES ============ -->
<section class="wrap" id="notes">
  <div class="sec-head rise">
    <h2>Field notes</h2>
    <span class="eyebrow">04 — Proof</span>
  </div>

  <div class="frames rise">
    <div class="frame filled wide"><img src="data:image/jpeg;base64," alt="Jameson and Dawsyn laughing in tall grass at golden hour" loading="lazy"></div>
    <div class="frame">Photo 02</div>
    <div class="frame">Photo 03</div>
    <div class="frame">Photo 04</div>
  </div>
  <p class="frames-note">Send more and they'll drop straight in. Empty frames read as room to grow until then.</p>
</section>

<footer>
  <div class="wrap foot">
    <div class="mark">J &amp; D</div>
    <div class="eyebrow" id="foot-count">—</div>
  </div>
</footer>

<script>
(function(){
  var root = document.documentElement;

  /* ---- theme ---- */
  function store(k,v){ try{ localStorage.setItem(k,v); }catch(e){} }
  function read(k){ try{ return localStorage.getItem(k); }catch(e){ return null; } }

  var saved = read('jd-theme');
  var prefersLight = window.matchMedia &&
                     window.matchMedia('(prefers-color-scheme: light)').matches;
  setTheme(saved || (prefersLight ? 'light' : 'dark'));

  function setTheme(t){
    root.setAttribute('data-theme', t);
    var meta = document.querySelector('meta[name="theme-color"]');
    if (meta) meta.setAttribute('content', t === 'light' ? '#F3F5F2' : '#0C2523');
    var btn = document.getElementById('themeBtn');
    if (btn) btn.setAttribute('aria-label',
      t === 'light' ? 'Switch to dark mode' : 'Switch to light mode');
  }

  var btn = document.getElementById('themeBtn');
  if (btn) btn.addEventListener('click', function(){
    var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    setTheme(next); store('jd-theme', next);
  });

  /* ---- countdown: Dec 30 2026, 2:00 PM Pacific ---- */
  var TARGET = Date.UTC(2026, 11, 30, 22, 0, 0);
  function tick(){
    var diff = TARGET - Date.now();
    var days = Math.max(0, Math.ceil(diff / 86400000));
    var d = document.getElementById('days');
    var f = document.getElementById('foot-count');
    if (d) d.textContent = diff <= 0 ? 'Married' : days.toLocaleString();
    if (f) f.textContent = diff <= 0
      ? 'Married in La Jolla · 12.30.2026'
      : days.toLocaleString() + ' days out · La Jolla, CA';
  }
  tick(); setInterval(tick, 60000);

  /* ---- reveals ---- */
  var items = document.querySelectorAll('.rise');
  var reduce = window.matchMedia &&
               window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduce || typeof IntersectionObserver === 'undefined'){
    Array.prototype.forEach.call(items, function(el){ el.classList.add('in'); });
    return;
  }
  var io = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if (e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); }
    });
  }, { threshold:0.1, rootMargin:'0px 0px -6% 0px' });
  Array.prototype.forEach.call(items, function(el, i){
    el.style.transitionDelay = (Math.min(i,4) * 65) + 'ms';
    io.observe(el);
  });
})();
</script>
</body>
</html>
