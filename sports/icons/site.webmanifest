{
  "id": "/sports/",
  "name": "Jamo Sports Hub",
  "short_name": "Jamo Sports",
  "description": "College football, the NFL, the NBA and college basketball in one place. Scope limited to /sports/ (not the whole djgolding.com origin).",
  "start_url": "/sports/?source=pwa",
  "scope": "/sports/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#070a12",
  "theme_color": "#070a12",
  "icons": [
    { "src": "/sports/icons/jsh-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/sports/icons/jsh-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/sports/icons/jsh.svg", "sizes": "any", "type": "image/svg+xml" }
  ],
  "shortcuts": [
    { "name": "Live Center", "short_name": "Live", "url": "/sports/live/" },
    { "name": "Alerts", "short_name": "Alerts", "url": "/sports/alerts/" },
    { "name": "Sports home", "short_name": "Home", "url": "/sports/" }
  ]
}
